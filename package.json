{
	"name": "nicookie",
	"version": "1.0.0",
	"private": true,
	"description": "Read your Chrome, Helium and Safari cookies on macOS, for local tools.",
	"license": "MIT",
	"bin": {
		"nicookie": "src/cli.ts"
	},
	"type": "module",
	"exports": "./src/index.ts",
	"scripts": {
		"check": "bun run fmt:check && bun run typecheck && bun run lint && bun run test",
		"fmt": "oxfmt --write .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint --type-aware --deny-warnings .",
		"test": "bun test --bail --coverage",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"typescript": "^7.0.2"
	}
}
